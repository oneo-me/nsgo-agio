---
// A segmented control over code: each tab says what it shows, gives the
// command that runs it, and the code itself.
import CodeBlock from './CodeBlock.astro';
import Command from './Command.astro';

interface Tab {
  id: string;
  label: string;
  title: string;
  body: string;
  command: string;
  code: string;
}

interface Props {
  tabs: readonly Tab[];
  label: string;
  id?: string;
  copyLabel?: string;
  commandLabel?: string;
}

const { tabs, label, id = 'tabs', copyLabel = 'Copy code', commandLabel = 'Copy command' } = Astro.props;
---

<div class="tabs" data-tabs id={id}>
  <div class="tab-list" role="tablist" aria-label={label}>
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${tab.id}`}
          aria-controls={`${id}-panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, index) => (
      <div
        role="tabpanel"
        id={`${id}-panel-${tab.id}`}
        aria-labelledby={`${id}-tab-${tab.id}`}
        tabindex="0"
        hidden={index !== 0}
      >
        <div class="tab-text">
          <p class="text-[17px] leading-relaxed text-muted">{tab.body}</p>
          <Command text={tab.command} label={commandLabel} />
        </div>
        <CodeBlock code={tab.code} title={tab.title} copyLabel={copyLabel} />
      </div>
    ))
  }
</div>

<style>
  .tabs {
    min-width: 0;
  }

  .tab-list {
    display: flex;
    gap: 2px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 40px;
    padding: 4px;
    overflow-x: auto;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  [role='tab'] {
    height: 36px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  [role='tab']:hover {
    color: var(--color-text);
  }

  [role='tab'][aria-selected='true'] {
    background: var(--color-panel);
    color: var(--color-text);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 10%),
      0 0 0 0.5px rgb(0 0 0 / 6%);
  }

  [role='tabpanel'] {
    min-width: 0;
    display: grid;
    gap: 28px;
    align-items: center;
  }

  @media (min-width: 900px) {
    [role='tabpanel'] {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 48px;
    }
  }

  [role='tabpanel'][hidden] {
    display: none;
  }

  [role='tabpanel']:focus-visible {
    outline-offset: 6px;
  }

  .tab-text {
    min-width: 0;
    display: grid;
    gap: 20px;
  }
</style>
