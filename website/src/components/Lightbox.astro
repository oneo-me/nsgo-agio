---
// The one dialog that enlarges any Shot on the page; src/scripts/site.ts
// fills it with the clicked shot's picture and steps through the others.
import Icon from './Icon.astro';
import type { Copy } from '../copy';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<dialog class="lightbox" data-lightbox-dialog aria-label={copy.lightbox.label}>
  <div class="lightbox-stage">
    <figure class="lightbox-figure">
      <div class="lightbox-media" data-lightbox-media></div>
      <figcaption>
        <span data-lightbox-caption></span>
        <span class="lightbox-count" data-lightbox-count></span>
      </figcaption>
    </figure>
  </div>
  <button type="button" class="lightbox-button lightbox-close" data-lightbox-close aria-label={copy.lightbox.close}>
    <Icon name="close" size={18} strokeWidth={2.2} />
  </button>
  <button type="button" class="lightbox-button lightbox-prev" data-lightbox-prev aria-label={copy.lightbox.previous}>
    <Icon name="chevron-left" size={18} strokeWidth={2.2} />
  </button>
  <button type="button" class="lightbox-button lightbox-next" data-lightbox-next aria-label={copy.lightbox.next}>
    <Icon name="chevron-right" size={18} strokeWidth={2.2} />
  </button>
</dialog>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    color: var(--color-text);
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 56px 88px 40px;
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
    max-height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox-figure {
      animation: lightbox-in 0.22s ease-out;
    }
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  .lightbox-media :global(picture) {
    display: contents;
  }

  .lightbox-media :global(img) {
    width: auto;
    max-width: min(100%, 1280px);
    height: auto;
    max-height: calc(100dvh - 140px);
    border-radius: 12px;
    box-shadow: var(--shadow-window);
  }

  .lightbox-figure figcaption {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    color: var(--color-muted);
    font-size: 15px;
    text-align: center;
  }

  .lightbox-count {
    color: var(--color-faint);
    font-variant-numeric: tabular-nums;
  }

  .lightbox-button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .lightbox-button:hover {
    background: color-mix(in srgb, var(--color-text) 14%, transparent);
  }

  .lightbox-button[hidden] {
    display: none;
  }

  .lightbox-close {
    top: 16px;
    right: 16px;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    margin-top: -20px;
  }

  .lightbox-prev {
    left: 24px;
  }

  .lightbox-next {
    right: 24px;
  }

  @media (max-width: 760px) {
    .lightbox-stage {
      padding: 64px 16px 80px;
    }

    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: 20px;
      margin-top: 0;
    }

    .lightbox-media :global(img) {
      max-height: calc(100dvh - 200px);
    }
  }
</style>
