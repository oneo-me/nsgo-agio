---
import Mark from './Mark.astro';
import type { Copy } from '../copy';
import { pagePath, site, type Lang } from '../site';

interface Props {
  lang: Lang;
  copy: Copy;
}

const { lang, copy } = Astro.props;

type FooterLink = { label: string; href: string; lang?: string };

const links: FooterLink[] = [
  { label: copy.footer.github, href: site.repo },
  { label: copy.footer.readme, href: site.readme },
  { label: copy.footer.chinese, href: site.readmeZh, lang: 'zh-CN' },
  { label: copy.footer.issues, href: site.issues },
  { label: copy.footer.architecture, href: site.architecture },
  { label: copy.footer.wire, href: site.wire },
  { label: copy.footer.changelog, href: site.changelog },
  { label: copy.footer.license, href: site.license },
];

const elsewhere: FooterLink[] = [
  { label: 'oneo.me', href: site.blog },
  { label: 'X', href: site.x },
  { label: 'NSGo', href: site.nsgo },
];

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line/70">
  <div class="wrap grid gap-10 py-12 md:grid-cols-[1fr_auto] md:items-start">
    <div class="max-w-sm">
      <a class="flex items-center gap-2.5" href={pagePath(lang)}>
        <Mark size={26} />
        <span class="text-[15px] font-semibold tracking-[-0.01em]">{site.name}</span>
      </a>
      <p class="mt-3 text-[13.5px] leading-relaxed text-faint">{copy.footer.note}</p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      <nav aria-label={copy.footer.project}>
        <p class="mono-label">{copy.footer.project}</p>
        <ul class="mt-3 grid gap-2">
          {
            links.map((link) => (
              <li>
                <a
                  class="text-[13.5px] text-muted transition-colors hover:text-text"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  lang={link.lang}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label={copy.footer.elsewhere}>
        <p class="mono-label">{copy.footer.elsewhere}</p>
        <ul class="mt-3 grid gap-2">
          {
            elsewhere.map((link) => (
              <li>
                <a
                  class="text-[13.5px] text-muted transition-colors hover:text-text"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  lang={link.lang}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-line/60">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-5 text-[12px] text-faint">
      <span>© {year} {site.author}</span>
      <span>{copy.footer.bottom}</span>
    </div>
  </div>
</footer>
