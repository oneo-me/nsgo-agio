---
import Mark from './Mark.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import type { Copy } from '../copy';
import { pagePath, site, type Lang } from '../site';

interface Props {
  lang: Lang;
  copy: Copy;
}

const { lang, copy } = Astro.props;

const links = [
  { label: copy.nav.github, href: site.repo },
  { label: copy.footer.readme, href: lang === 'zh' ? site.readmeZh : site.readme },
  { label: copy.footer.changelog, href: site.changelog },
  { label: copy.footer.issues, href: site.issues },
  { label: copy.footer.license, href: site.license },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="wrap flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-3">
      <a href={pagePath(lang)} aria-label={copy.nav.home}><Mark size={26} id="agio-footer" /></a>
      <p class="text-[13px] text-faint">
        <span class="font-semibold text-text">{site.name}</span> · {copy.footer.note} © {year}{' '}
        <a class="hover:text-text" href={site.blog} target="_blank" rel="noopener noreferrer">{site.author}</a>
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-[13px] text-muted" aria-label={copy.footer.links}>
      {
        links.map((link) => (
          <a class="transition-colors hover:text-text" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeSwitch copy={copy} />
      <LanguageSwitch lang={lang} copy={copy} />
    </div>
  </div>
</footer>
