---
interface Props {
  size?: number;
  class?: string;
  /** A unique id if the mark appears more than once with different gradients. */
  id?: string;
}

const { size = 32, class: className, id = 'agio-mark' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="196 208 632 632"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`${id}-bg`} x1="512" y1="232" x2="512" y2="812" gradientUnits="userSpaceOnUse">
      <stop stop-color="#3a94ff"></stop>
      <stop offset="1" stop-color="#0068e8"></stop>
    </linearGradient>
  </defs>
  <path
    fill={`url(#${id}-bg)`}
    d="M362 232H662A150 150 0 0 1 812 382V566A150 150 0 0 1 662 716H436L300 812C284 823 264 810 268 791L288 704A150 150 0 0 1 212 566V382A150 150 0 0 1 362 232Z"
  ></path>
  <path
    d="M382 384 476 474 382 564"
    stroke="#fff"
    stroke-width="68"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <rect x="532" y="530" width="138" height="68" rx="34" fill="#fff"></rect>
</svg>
