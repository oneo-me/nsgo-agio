---
import { Code } from 'astro:components';
import CopyButton from './CopyButton.astro';
import Icon from './Icon.astro';

interface Props {
  code: string;
  lang?: 'go' | 'bash' | 'json' | 'text';
  title?: string;
  copyLabel?: string;
  class?: string;
}

const { code, lang = 'go', title = 'main.go', copyLabel = 'Copy code', class: className } = Astro.props;
---

<figure class:list={['code-card', className]}>
  <figcaption>
    <span class="code-title">
      <Icon name="terminal" size={13} />
      {title}
    </span>
    <CopyButton text={code} label={copyLabel} />
  </figcaption>
  <div class="code-body">
    <Code code={code} lang={lang} theme="css-variables" />
  </div>
</figure>

<style>
  .code-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-panel);
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 38px;
    padding: 0 8px 0 14px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg-soft);
  }

  .code-title {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .code-body {
    min-width: 0;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.65;
  }

  .code-body :global(pre.astro-code) {
    margin: 0;
    width: 100%;
    padding: 18px 20px !important;
    background: transparent !important;
  }

  .code-body :global(code) {
    font-size: inherit;
  }

  @media (max-width: 540px) {
    .code-body {
      font-size: 12px;
    }

    .code-body :global(pre.astro-code) {
      padding: 16px !important;
    }
  }
</style>
