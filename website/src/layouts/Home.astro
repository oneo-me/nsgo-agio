---
// The product page. Each section is self-contained and draws its words
// from src/copy.ts, so another app's site keeps the order it needs and
// drops the rest: hero and stage, a strip of names, features, a showcase,
// an interactive section, three columns, a call to start, and "built with".
import Layout from './Layout.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import Command from '../components/Command.astro';
import Tabs from '../components/Tabs.astro';
import Shot from '../components/Shot.astro';
import Stage from '../components/Stage.astro';
import { copies } from '../copy';
import { pagePath, site, type Lang } from '../site';
import appDark from '../assets/screens/app-dark.png';
import appLight from '../assets/screens/app-light.png';
import appDetailDark from '../assets/screens/app-detail-dark.png';
import appDetailLight from '../assets/screens/app-detail-light.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = copies[lang];
---

<Layout
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  zhRedirect={lang === 'en' ? pagePath('zh') : undefined}
>
  <!-- Hero ------------------------------------------------------------ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-copy">
      <a class="announce" href={site.wire} target="_blank" rel="noopener noreferrer">
        <span class="announce-tag">{copy.hero.badge.tag}</span>
        <span>{copy.hero.badge.text}</span>
        <Icon name="chevron-right" size={15} class="text-faint" />
      </a>
      <h1 id="hero-title" class="hero-title">{copy.hero.title}</h1>
      <p class="hero-lede">{copy.hero.lede}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-large" href="#start">{copy.hero.primary}</a>
        <a class="btn btn-secondary btn-large" href={site.repo} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={18} />
          {copy.hero.secondary}
        </a>
      </div>
      <p class="hero-fine">{copy.hero.fine}</p>
    </div>

    <Stage tone={copy.hero.tone} class="hero-stage">
      <Shot
        light={appLight}
        dark={appDark}
        alt={copy.hero.alt}
        caption={copy.hero.caption}
        showCaption={false}
        enlarge={copy.lightbox.enlarge}
        loading="eager"
      />
    </Stage>
  </section>

  <!-- Names ----------------------------------------------------------- -->
  <section class="wrap names" aria-labelledby="names-title">
    <p id="names-title" class="names-title">{copy.agents.title}</p>
    <ul class="names-list">
      {copy.agents.names.map((name) => <li>{name}</li>)}
    </ul>
    <p class="names-note">{copy.agents.note}</p>
  </section>

  <!-- Features -------------------------------------------------------- -->
  <section id="features" class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="features-title" class="section-title">{copy.features.title}</h2>
        <p class="section-lead">{copy.features.lead}</p>
      </div>
      <div class="features">
        {
          copy.features.items.map((item) => (
            <article>
              <h3 class="feature-title">
                <span class:list={['led', `led-${item.led}`]} />
                {item.title}
              </h3>
              <p class="feature-body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Showcase -------------------------------------------------------- -->
  <section class="pb-[120px] max-md:pb-20" aria-labelledby="showcase-title">
    <div class="wrap section-head mb-14">
      <h2 id="showcase-title" class="section-title">{copy.showcase.title}</h2>
      <p class="section-lead">{copy.showcase.lead}</p>
    </div>
    <Stage tone={copy.showcase.tone}>
      <Shot
        light={appDetailLight}
        dark={appDetailDark}
        alt={copy.showcase.alt}
        caption={copy.showcase.caption}
        enlarge={copy.lightbox.enlarge}
      />
    </Stage>
    <ul class="wrap notes">
      {
        copy.showcase.notes.map((note) => (
          <li>
            <p class="feature-title">
              <span class:list={['led', `led-${note.led}`]} />
              {note.title}
            </p>
            <p class="feature-body">{note.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- How it works ---------------------------------------------------- -->
  <section id="how" class="section band" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head mb-12">
        <h2 id="how-title" class="section-title">{copy.how.title}</h2>
        <p class="section-lead">{copy.how.lead}</p>
      </div>
      <Tabs
        tabs={copy.how.tabs}
        id="how-tabs"
        label={copy.how.tabsLabel}
        copyLabel={copy.code.copy}
        commandLabel={copy.code.command}
      />
      <p class="mt-12 text-center">
        <a class="text-link" href={site.architecture} target="_blank" rel="noopener noreferrer">
          {copy.how.link}
          <Icon name="arrow-right" size={15} />
        </a>
      </p>
    </div>
  </section>

  <!-- Under the hood -------------------------------------------------- -->
  <section id="under" class="section" aria-labelledby="under-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="under-title" class="section-title">{copy.under.title}</h2>
        <p class="section-lead">{copy.under.lead}</p>
      </div>
      <div class="columns">
        {
          copy.under.items.map((item) => (
            <article>
              <p class="column-value">{item.value}</p>
              <h3 class="column-title">{item.title}</h3>
              <p class="feature-body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Start ----------------------------------------------------------- -->
  <section id="start" class="wrap pb-24" aria-labelledby="start-title">
    <div class="start">
      <Mark size={72} id="agio-start" class="start-mark" />
      <h2 id="start-title" class="section-title">{copy.start.title}</h2>
      <p class="section-lead">{copy.start.lead}</p>
      <Command text={site.install} label={copy.code.command} class="start-command" />
      <div class="hero-actions">
        <a class="btn btn-primary" href={site.readme} target="_blank" rel="noopener noreferrer">
          <Icon name="book" size={16} />
          {copy.start.readme}
        </a>
        <a class="btn btn-secondary" href={site.examples} target="_blank" rel="noopener noreferrer">
          {copy.start.examples}
          <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
      <p class="start-fine">{copy.start.requirements}</p>
    </div>
  </section>

  <!-- Built with ------------------------------------------------------ -->
  <section class="built" aria-labelledby="built-title">
    <svg class="built-mark" viewBox="-16.51 -2.63 129.26 129.26" width="40" height="40" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="nsgo-mark" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#b3dbff"></stop>
          <stop offset="1" stop-color="#4da6ff"></stop>
        </linearGradient>
      </defs>
      <g transform="skewX(-10)">
        <rect x="12.5" y="40.5" width="26" height="11" rx="5.5" fill="#7cc0ff"></rect>
        <rect x="2.5" y="56.5" width="36" height="11" rx="5.5" fill="#7cc0ff"></rect>
        <rect x="16.5" y="72.5" width="22" height="11" rx="5.5" fill="#7cc0ff"></rect>
      </g>
      <g transform="skewX(-10)">
        <path
          d="M68.0 23.0 H88.0 A25.0 25.0 0 0 1 113.0 48.0 V76.0 A25.0 25.0 0 0 1 88.0 101.0 H68.0 A25.0 25.0 0 0 1 43.0 76.0 V48.0 A25.0 25.0 0 0 1 68.0 23.0 Z M68.0 37.0 A11.0 11.0 0 0 0 57.0 48.0 V76.0 A11.0 11.0 0 0 0 68.0 87.0 H88.0 A11.0 11.0 0 0 0 99.0 76.0 V48.0 A11.0 11.0 0 0 0 88.0 37.0 Z"
          fill="url(#nsgo-mark)"></path>
      </g>
    </svg>
    <h2 id="built-title" class="built-title">{copy.built.title}</h2>
    <p class="built-body">{copy.built.body}</p>
    <nav class="built-links" aria-label="NSGo">
      <a href={site.nsgo} target="_blank" rel="noopener noreferrer">{copy.built.nsgo}</a>
      <a href={site.nsgoRepo} target="_blank" rel="noopener noreferrer">{copy.built.nsgoRepo}</a>
    </nav>
  </section>
</Layout>

<style>
  /* Hero ------------------------------------------------------------- */
  .hero {
    padding-top: 56px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .announce {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    padding: 4px 12px 4px 4px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, var(--color-line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-panel));
    font-size: 14.5px;
    font-weight: 500;
    transition: border-color 0.15s ease;
  }

  .announce:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-line));
  }

  .announce-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent-ink);
    font-weight: 600;
  }

  .hero-title {
    margin-top: 28px;
    font-size: clamp(44px, 8.4vw, 92px);
    letter-spacing: -0.045em;
    line-height: 1.04;
    white-space: pre-line;
  }

  html[lang='zh-CN'] .hero-title {
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .hero-lede {
    max-width: 44ch;
    margin-top: 24px;
    color: var(--color-muted);
    font-size: clamp(18px, 2.2vw, 21px);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
  }

  .btn-large {
    height: 52px;
    padding: 0 28px;
    font-size: 17px;
  }

  .hero-fine {
    margin-top: 18px;
    color: var(--color-faint);
    font-size: 13px;
  }

  :global(.hero-stage) {
    margin-top: 64px;
  }

  /* Names ------------------------------------------------------------ */
  .names {
    padding-top: 72px;
    text-align: center;
  }

  .names-title {
    color: var(--color-faint);
    font-size: 14px;
  }

  .names-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 44px;
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.6vw, 26px);
    font-weight: 600;
    letter-spacing: -0.02em;
    opacity: 0.75;
  }

  .names-note {
    margin-top: 12px;
    color: var(--color-faint);
    font-size: 13px;
  }

  /* Features and notes ----------------------------------------------- */
  .features {
    display: grid;
    gap: 44px 40px;
    margin-top: 72px;
  }

  @media (min-width: 700px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .features {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .feature-body {
    margin-top: 8px;
    color: var(--color-muted);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .notes {
    display: grid;
    gap: 28px 40px;
    max-width: 1000px;
    margin-top: 48px;
  }

  @media (min-width: 760px) {
    .notes {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* How it works ----------------------------------------------------- */
  .band {
    background: var(--color-bg-soft);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent);
    font-size: 16px;
    font-weight: 500;
  }

  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Columns ---------------------------------------------------------- */
  .columns {
    display: grid;
    gap: 40px;
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 760px) {
    .columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .column-value {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .column-title {
    margin-top: 10px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Start ------------------------------------------------------------ */
  .start {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(48px, 8vw, 88px) clamp(20px, 6vw, 64px);
    border-radius: clamp(20px, 3vw, 36px);
    background: var(--stage-blue);
    text-align: center;
  }

  .start :global(.start-mark) {
    margin-bottom: 28px;
    filter: drop-shadow(0 16px 30px rgb(0 100 255 / 30%));
  }

  .start :global(.start-command) {
    width: min(480px, 100%);
    margin-top: 32px;
    text-align: left;
  }

  .start .hero-actions {
    margin-top: 20px;
  }

  .start-fine {
    max-width: 52ch;
    margin-top: 22px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    font-size: 13.5px;
  }

  /* Built with ------------------------------------------------------- */
  .built {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 48ch;
    margin: 0 auto;
    padding: 40px 24px 96px;
    text-align: center;
  }

  .built-mark {
    margin-bottom: 16px;
  }

  .built-title {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .built-body {
    margin-top: 8px;
    color: var(--color-muted);
    font-size: 15px;
  }

  .built-links {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    color: var(--color-accent);
    font-size: 15px;
    font-weight: 500;
  }

  .built-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 36px;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    :global(.hero-stage) {
      margin-top: 44px;
    }
  }
</style>
