---
import Layout from './Layout.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import Command from '../components/Command.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Tabs from '../components/Tabs.astro';
import Window from '../components/Window.astro';
import { copies } from '../copy';
import { pagePath, site, type Lang } from '../site';
import appDark from '../assets/screens/app-dark.png';
import appLight from '../assets/screens/app-light.png';
import appDetailDark from '../assets/screens/app-detail-dark.png';
import appDetailLight from '../assets/screens/app-detail-light.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = copies[lang];
const singleCode = copy.start.tabs[0].code;
---

<Layout
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  zhRedirect={lang === 'en' ? pagePath('zh') : undefined}
>
  <!-- Hero ------------------------------------------------------------ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap relative">
      <div class="hero-copy">
        <Mark size={88} id="agio-hero" class="hero-mark" />
        <h1 id="hero-title" class="hero-title">{copy.hero.title}</h1>
        <p class="hero-lede">{copy.hero.lede}</p>
        <p class="hero-body">{copy.hero.body}</p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a class="btn btn-primary" href="#start">
            {copy.hero.primary}
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn-secondary" href={site.repo} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={17} />
            {copy.hero.secondary}
          </a>
        </div>

        <div class="hero-install">
          <p class="mono-label">{copy.hero.installLabel}</p>
          <Command text={site.install} label={copy.code.command} />
        </div>

        <ul class="hero-fine" aria-label={copy.hero.glanceLabel}>
          {copy.hero.fine.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="stream stream-wide" aria-hidden="true"><span></span></div>

      <div class="hero-shot">
        <Window
          light={appLight}
          dark={appDark}
          alt={copy.hero.alt}
          caption={copy.hero.caption}
          loading="eager"
          widths={[720, 1080, 1440, 2000, 2360]}
        />
      </div>
    </div>
  </section>

  <!-- Agents ---------------------------------------------------------- -->
  <section class="border-y border-line/60 bg-bg-soft/40" aria-label={copy.agents.label}>
    <div class="wrap flex flex-col gap-4 py-7 md:flex-row md:items-center md:justify-between">
      <p class="text-[13px] text-faint">{copy.agents.title}</p>
      <ul class="flex flex-wrap items-center gap-x-7 gap-y-3">
        {
          copy.agents.names.map((name) => (
            <li class="flex items-center gap-2 font-mono text-[12.5px] text-muted">
              <span class="h-1.5 w-1.5 rounded-full bg-accent/80"></span>
              {name}
            </li>
          ))
        }
        <li class="font-mono text-[12px] text-faint">{copy.agents.note}</li>
      </ul>
    </div>
  </section>

  <!-- Features -------------------------------------------------------- -->
  <section id="features" class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="max-w-[680px]">
        <p class="eyebrow">{copy.features.eyebrow}</p>
        <h2 id="features-title" class="section-title">{copy.features.title}</h2>
        <p class="section-lead">{copy.features.lead}</p>
      </div>

      <div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          copy.features.items.map((item) => (
            <article class:list={[`accent-${item.accent}`, 'feature-item']}>
              <div class="flex items-center gap-3">
                <span class="feature-dot"></span>
                <Icon name={item.icon} size={17} class="text-faint" />
              </div>
              <h3 class="mt-5 text-[18px] font-semibold tracking-[-0.02em]">{item.title}</h3>
              <p class="mt-2.5 text-[14.5px] leading-relaxed text-muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works ---------------------------------------------------- -->
  <section id="how" class="section border-t border-line/60" aria-labelledby="how-title">
    <div class="wrap">
      <div class="max-w-[680px]">
        <p class="eyebrow">{copy.how.eyebrow}</p>
        <h2 id="how-title" class="section-title">{copy.how.title}</h2>
        <p class="section-lead">{copy.how.lead}</p>
      </div>

      <div class="mt-12 grid min-w-0 gap-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-start">
        <div class="arch" aria-label={copy.how.diagramLabel}>
          <div class="arch-group">
            <p class="mono-label">{copy.how.viewLabel}</p>
            <div class="arch-node arch-node-view">{copy.how.viewNode}</div>
          </div>

          <div class="arch-link"><span>{copy.how.contract}</span></div>

          <div class="arch-split">
            <div class="arch-group">
              <p class="mono-label">{copy.how.localLabel}</p>
              <div class="arch-node">{copy.how.localNode}</div>
            </div>
            <div class="arch-or">or</div>
            <div class="arch-group">
              <p class="mono-label">{copy.how.remoteLabel}</p>
              <div class="arch-pair">
                <div class="arch-node">{copy.how.remoteClient}</div>
                <span class="arch-swap" aria-hidden="true">⇄</span>
                <div class="arch-node">{copy.how.remoteServer}</div>
              </div>
            </div>
          </div>

          <div class="arch-link"><span>{copy.how.driversLabel}</span></div>

          <div class="arch-tools">{copy.how.drivers}</div>
        </div>

        <div class="min-w-0">
          <CodeBlock code={singleCode} title={copy.how.codeTitle} copyLabel={copy.code.copy} />
          <p class="mt-5 text-[13.5px] leading-relaxed text-faint">{copy.how.note}</p>
          <a
            class="mt-5 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent transition-colors hover:text-accent-ink"
            href={site.architecture}
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.how.link}
            <Icon name="arrow-up-right" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Turns ----------------------------------------------------------- -->
  <section class="section border-t border-line/60" aria-labelledby="turns-title">
    <div class="wrap">
      <div class="turns-head">
        <div class="max-w-[620px]">
          <p class="eyebrow">{copy.turns.eyebrow}</p>
          <h2 id="turns-title" class="section-title">{copy.turns.title}</h2>
          <p class="section-lead">{copy.turns.lead}</p>
        </div>
        <ul class="turns-notes">
          {
            copy.turns.notes.map((note) => (
              <li>
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-accent">{note.label}</span>
                <span class="mt-1 block text-[13px] leading-snug text-faint">{note.body}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-12">
        <Window
          light={appDetailLight}
          dark={appDetailDark}
          alt={copy.turns.alt}
          caption={copy.turns.caption}
          widths={[720, 1080, 1440, 2000, 2360]}
        />
      </div>
    </div>
  </section>

  <!-- Under the hood -------------------------------------------------- -->
  <section class="section border-t border-line/60" aria-labelledby="under-title">
    <div class="wrap">
      <div class="max-w-[680px]">
        <p class="eyebrow">{copy.under.eyebrow}</p>
        <h2 id="under-title" class="section-title">{copy.under.title}</h2>
        <p class="section-lead">{copy.under.lead}</p>
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-0">
        {
          copy.under.items.map((item) => (
            <article class="under-item">
              <p class="font-mono text-[12px] text-accent">{item.value}</p>
              <h3 class="mt-3 text-[16px] font-semibold tracking-[-0.01em]">{item.title}</h3>
              <p class="mt-2 max-w-[36ch] text-[13.5px] leading-relaxed text-muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Quick start ----------------------------------------------------- -->
  <section id="start" class="section border-t border-line/60" aria-labelledby="start-title">
    <div class="wrap grid min-w-0 gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div class="min-w-0 lg:sticky lg:top-24">
        <p class="eyebrow">{copy.start.eyebrow}</p>
        <h2 id="start-title" class="section-title start-title">{copy.start.title}</h2>
        <p class="section-lead">{copy.start.lead}</p>

        <p class="mono-label mt-8">{copy.start.installLabel}</p>
        <Command text={site.install} label={copy.code.command} class="mt-3" />

        <p class="mt-5 max-w-[46ch] text-[13px] leading-relaxed text-faint">{copy.start.requirements}</p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn btn-secondary btn-small" href={site.readme} target="_blank" rel="noopener noreferrer">
            <Icon name="book" size={15} />
            {copy.start.readme}
          </a>
          <a class="btn btn-secondary btn-small" href={site.examples} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={15} />
            {copy.start.examples}
          </a>
        </div>
      </div>

      <Tabs
        tabs={copy.start.tabs}
        label={copy.start.tabsLabel}
        copyLabel={copy.code.copy}
        commandLabel={copy.code.command}
      />
    </div>
  </section>

  <!-- Built with ------------------------------------------------------ -->
  <section class="border-t border-line/60" aria-labelledby="built-title">
    <div class="wrap flex flex-col gap-8 py-16 md:flex-row md:items-start md:justify-between">
      <div class="flex items-start gap-5">
        <div class="built-mark" aria-hidden="true">
          <svg viewBox="-16.51 -2.63 129.26 129.26" width="38" height="38" fill="none">
            <defs>
              <linearGradient id="nsgo-mark" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#b3dbff"></stop>
                <stop offset="1" stop-color="#4da6ff"></stop>
              </linearGradient>
            </defs>
            <g transform="skewX(-10)">
              <rect x="12.5" y="40.5" width="26" height="11" rx="5.5" fill="#7cc0ff"></rect>
              <rect x="2.5" y="56.5" width="36" height="11" rx="5.5" fill="#7cc0ff"></rect>
              <rect x="16.5" y="72.5" width="22" height="11" rx="5.5" fill="#7cc0ff"></rect>
            </g>
            <g transform="skewX(-10)">
              <path
                d="M68.0 23.0 H88.0 A25.0 25.0 0 0 1 113.0 48.0 V76.0 A25.0 25.0 0 0 1 88.0 101.0 H68.0 A25.0 25.0 0 0 1 43.0 76.0 V48.0 A25.0 25.0 0 0 1 68.0 23.0 Z M68.0 37.0 A11.0 11.0 0 0 0 57.0 48.0 V76.0 A11.0 11.0 0 0 0 68.0 87.0 H88.0 A11.0 11.0 0 0 0 99.0 76.0 V48.0 A11.0 11.0 0 0 0 88.0 37.0 Z"
                fill="url(#nsgo-mark)"></path>
            </g>
          </svg>
        </div>
        <div class="max-w-[560px]">
          <p class="eyebrow">{copy.built.eyebrow}</p>
          <h2 id="built-title" class="mt-3 text-[22px] font-semibold tracking-[-0.02em]">{copy.built.title}</h2>
          <p class="mt-2 text-[14px] leading-relaxed text-muted">{copy.built.body}</p>
        </div>
      </div>
      <div class="flex shrink-0 gap-5 md:pt-8">
        <a class="built-link" href={site.nsgo} target="_blank" rel="noopener noreferrer">{copy.built.nsgo}</a>
        <a class="built-link" href={site.nsgoRepo} target="_blank" rel="noopener noreferrer">{copy.built.nsgoRepo}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .start-title {
    white-space: pre-line;
  }

  .section {
    padding-block: 104px;
  }

  @media (max-width: 768px) {
    .section {
      padding-block: 72px;
    }
  }

  /* Hero ------------------------------------------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 82px 0 0;
  }

  .hero-glow {
    position: absolute;
    top: -160px;
    left: 50%;
    width: 1100px;
    height: 760px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, var(--hero-glow), transparent 72%);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-mark {
    filter: drop-shadow(0 18px 38px rgb(0 122 255 / 34%));
  }

  .hero-title {
    margin-top: 26px;
    font-size: clamp(64px, 9vw, 92px);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .hero-lede {
    max-width: 32ch;
    margin-top: 16px;
    color: var(--color-text);
    font-size: clamp(24px, 3.2vw, 32px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.22;
  }

  .hero-body {
    max-width: 62ch;
    margin-top: 16px;
    color: var(--color-muted);
    font-size: 15.5px;
    line-height: 1.65;
  }

  .hero-install {
    width: min(460px, 100%);
    margin-top: 26px;
    text-align: left;
  }

  .hero-install .mono-label {
    margin-bottom: 8px;
  }

  .hero-fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 16px;
    margin-top: 16px;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.01em;
  }

  .hero-fine li + li::before {
    margin-right: 16px;
    color: var(--color-line-strong);
    content: '·';
  }

  .stream {
    position: relative;
    height: 1px;
    margin: 54px auto 30px;
    background: linear-gradient(90deg, transparent, var(--color-line-strong) 18%, var(--color-line-strong) 82%, transparent);
    overflow: hidden;
  }

  .stream span {
    position: absolute;
    top: 0;
    left: -18%;
    width: 18%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .stream span {
      animation: stream 7s linear infinite;
    }
  }

  @keyframes stream {
    to {
      left: 100%;
    }
  }

  .hero-shot {
    position: relative;
    width: 100%;
    padding-bottom: 10px;
  }

  .hero-shot::before {
    position: absolute;
    z-index: -1;
    inset: 8% 8% -4%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--shot-glow), transparent);
    content: '';
    filter: blur(30px);
  }

  /* Features --------------------------------------------------------- */
  .feature-item {
    border-top: 1px solid var(--color-line);
    padding-top: 20px;
  }

  @media (max-width: 640px) {
    .feature-item {
      padding-top: 18px;
    }
  }

  /* Architecture ----------------------------------------------------- */
  .arch {
    min-width: 0;
    display: grid;
    gap: 0;
    padding: 22px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background:
      radial-gradient(600px 300px at 50% 0, var(--arch-glow), transparent 70%),
      var(--color-panel);
  }

  .arch-group {
    display: grid;
    gap: 8px;
  }

  .arch-node {
    padding: 11px 13px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: var(--color-bg-soft);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.4;
    text-align: center;
  }

  .arch-node-view {
    border-color: rgb(87 170 255 / 34%);
    background: rgb(0 122 255 / 8%);
    color: var(--color-text);
  }

  .arch-link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 10.5px;
  }

  .arch-link::before {
    width: 1px;
    height: 100%;
    background: linear-gradient(var(--color-accent), transparent);
    content: '';
    opacity: 0.45;
  }

  .arch-link span {
    padding: 0 10px;
    border: 1px solid rgb(87 170 255 / 22%);
    border-radius: 999px;
    background: var(--color-bg-soft);
    line-height: 22px;
  }

  .arch-split {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 10px;
    align-items: stretch;
    padding: 12px;
    border: 1px dashed var(--color-line-strong);
    border-radius: 10px;
  }

  .arch-or {
    align-self: center;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .arch-pair {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .arch-pair .arch-node {
    flex: 1;
    padding-inline: 6px;
    font-size: 10.5px;
  }

  .arch-swap {
    color: var(--color-accent);
    font-size: 13px;
  }

  .arch-tools {
    padding: 12px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: var(--color-bg-soft);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-align: center;
  }

  /* Turns ------------------------------------------------------------ */
  .turns-head {
    display: grid;
    gap: 32px;
  }

  .turns-notes {
    display: grid;
    gap: 18px;
    padding-top: 8px;
  }

  @media (min-width: 860px) {
    .turns-head {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
      align-items: end;
    }

    .turns-notes {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  /* Under the hood --------------------------------------------------- */
  .under-item {
    border-top: 1px solid var(--color-line);
    padding-top: 20px;
  }

  @media (min-width: 768px) {
    .under-item {
      padding: 0 28px;
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }

    .under-item:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .under-item:last-child {
      padding-right: 0;
    }
  }

  /* Built with ------------------------------------------------------- */
  .built-mark {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border: 1px solid var(--color-line);
    border-radius: 13px;
    background: var(--color-panel);
  }

  .built-link {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    transition: color 0.15s ease;
  }

  .built-link:hover {
    color: var(--color-text);
  }

  /* Small screens ---------------------------------------------------- */
  @media (max-width: 640px) {
    .hero {
      padding-top: 58px;
    }

    .hero-title {
      margin-top: 20px;
    }

    .hero-lede {
      margin-top: 14px;
    }

    .stream {
      margin: 48px auto 26px;
    }

    .arch {
      padding: 14px;
    }

    .arch-split {
      grid-template-columns: 1fr;
    }

    .arch-or {
      justify-self: center;
    }
  }
</style>
